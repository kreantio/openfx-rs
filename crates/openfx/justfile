set fallback := true

data-path := "../../vendor/openfx-data/data"
generated-c-bindings-path := "src/generated/sys/bindings"
generated-code-low-path := "src/generated/low"
generated-code-low-plugin-path := "src/generated/low_plugin"
codegen-config-path := "codegen-config.yaml"

generate-all: generate-bindings generate-code
    rm -f src/generated/mod.rs
    cargo xtask --codegen-config "{{ codegen-config-path }}" \
      make-mod-rs src/generated --recursive
    find ./src/generated -name "*.rs" -exec rustfmt --edition=2024 {} +

generate-bindings:
    rm -rf "{{ generated-c-bindings-path }}"
    mkdir -p "{{ generated-c-bindings-path }}"
    cargo run --manifest-path ../../vendor/openfx-data/openfx-datagen/crates/openfx-bindgen/Cargo.toml -- \
      --input-data "{{ data-path }}/generated/bindings" \
      --output "{{ generated-c-bindings-path }}"

generate-code:
    rm -rf "{{ generated-code-low-path }}" "{{ generated-code-low-plugin-path }}"
    mkdir -p "{{ generated-code-low-path }}" "{{ generated-code-low-plugin-path }}"
    cargo run --release --package openfx-codegen --bin cli -- \
      --codegen-config="{{ codegen-config-path }}" \
      --input-bindings-data "{{ data-path }}/generated/bindings" \
      --input-metadata "{{ data-path }}/generated/metadata" \
      --output-code-low "{{ generated-code-low-path }}" \
      --output-code-low-plugin "{{ generated-code-low-plugin-path }}"
