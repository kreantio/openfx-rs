set fallback := true

data-path := "../../vendor/openfx-data/data"
generated-path := "generated"
generated-c-bindings-path := "generated/c_bindings"
vendor-cpp-path := "../../vendor/openfx/openfx-cpp/include/openfx"
generated-code-from-c-path := "generated/code_from_c"
generated-code-from-cpp-path := "generated/code_from_cpp"
generated-code-from-metadata-path := "generated/code_from_metadata"
codegen-config-path := "codegen-config.toml"

# TODO: remove this folder.

generated-intermediate-path := "generated-intermediate"

generate-all: generate-bindings generate-code

generate-bindings:
    rm -rf "{{ generated-c-bindings-path }}"
    mkdir -p "{{ generated-c-bindings-path }}"
    cargo run --manifest-path ../../vendor/openfx-data/openfx-datagen/crates/openfx-bindgen/Cargo.toml -- \
      --input-data "{{ data-path }}/generated/bindings" \
      --output "{{ generated-c-bindings-path }}"

generate-code:
    # Order matters here. (The cpp one relies on `generated/code_from_c/data`
    # generated by the c one.)
    just generate-code-from-metadata
    just generate-code-from-cpp

generate-code-from-metadata:
    rm -rf "{{ generated-code-from-c-path }}" "{{ generated-code-from-metadata-path }}"
    mkdir -p "{{ generated-code-from-c-path }}" "{{ generated-code-from-metadata-path }}"
    cargo run --release --package openfx-codegen --bin cli -- \
      --codegen-config="{{ codegen-config-path }}" \
      --input-bindings-data "{{ data-path }}/generated/bindings" \
      --input-metadata "{{ data-path }}/generated/metadata" \
      --output "{{ generated-path }}" \

generate-code-from-cpp:
    rm -rf "{{ generated-code-from-cpp-path }}"
    mkdir -p "{{ generated-code-from-cpp-path }}"
    deno run --allow-read="{{ vendor-cpp-path }}" \
      --allow-read="{{ codegen-config-path }}" \
      --allow-read="{{ generated-intermediate-path }}" \
      --allow-write="{{ generated-code-from-cpp-path }}" \
      scripts/bin/generate-code-from-cpp.ts \
      --codegen-config="{{ codegen-config-path }}" \
      --input-cpp-headers="{{ vendor-cpp-path }}" \
      --input-intermediate="{{ generated-intermediate-path }}" \
      --output-code-from-cpp="{{ generated-code-from-cpp-path }}"
    find "{{ generated-code-from-cpp-path }}" -name "*.rs" | xargs rustfmt
