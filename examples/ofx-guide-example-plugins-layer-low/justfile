build *args:
    ./scripts/bundle.sh \
      --base-name OfxGuideExamplePluginsLayerLow \
      --info-plist assets/info.plist \
      {{ args }}

build-preferring-dash *args:
    #!/usr/bin/env sh
    # NOTE: On macOS, `/bin/sh` is bash. Luckily, dash is now also built into
    # macOS, so we can prefer using dash to ensure POSIX compliance.
    if command -v dash >/dev/null 2>&1; then
        echo "Found dash, using dash." >&2
        SH="dash"
    else
        SH="sh"
    fi

    /usr/bin/env "$SH" ./scripts/bundle.sh \
      --base-name OfxGuideExamplePluginsLayerLow \
      --info-plist assets/info.plist \
      {{ args }}
