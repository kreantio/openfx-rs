{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TODO",
  "type": "object",
  "properties": {
    "unprocessed_includes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "copyright_comments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RootItemWithCommentAbove"
      }
    }
  },
  "required": [
    "unprocessed_includes",
    "copyright_comments",
    "items"
  ],
  "$defs": {
    "RootItemWithCommentAbove": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "comment_above": {
              "type": [
                "string",
                "null"
              ]
            },
            "item": {
              "$ref": "#/$defs/RootItem"
            },
            "$type": {
              "type": "string",
              "const": "Item"
            }
          },
          "required": [
            "$type",
            "item"
          ]
        },
        {
          "type": "object",
          "properties": {
            "comment": {
              "type": "string"
            },
            "$type": {
              "type": "string",
              "const": "StandaloneComment"
            }
          },
          "required": [
            "$type",
            "comment"
          ]
        }
      ]
    },
    "RootItem": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/DefineValue"
            },
            "comment": {
              "type": [
                "string",
                "null"
              ]
            },
            "$type": {
              "type": "string",
              "const": "Define"
            }
          },
          "required": [
            "$type",
            "name",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "c_type": {
              "$ref": "#/$defs/TypedefPrimitiveCType"
            },
            "$type": {
              "type": "string",
              "const": "TypedefPrimitive"
            }
          },
          "required": [
            "$type",
            "name",
            "c_type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "pointee_struct_name": {
              "type": "string"
            },
            "$type": {
              "type": "string",
              "const": "TypedefOpaquePointer"
            }
          },
          "required": [
            "$type",
            "name",
            "pointee_struct_name"
          ]
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "parameters": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/FunctionParameter"
              }
            },
            "is_variadic": {
              "type": "boolean"
            },
            "return_type": {
              "$ref": "#/$defs/TypedefFunctionReturnType"
            },
            "$type": {
              "type": "string",
              "const": "TypedefFunction"
            }
          },
          "required": [
            "$type",
            "name",
            "parameters",
            "is_variadic",
            "return_type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "fields": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/TypedefStructField"
              }
            },
            "$type": {
              "type": "string",
              "const": "TypedefStruct"
            }
          },
          "required": [
            "$type",
            "name",
            "fields"
          ]
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "variants": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/TypedefEnumVariant"
              }
            },
            "$type": {
              "type": "string",
              "const": "TypedefEnum"
            }
          },
          "required": [
            "$type",
            "name",
            "variants"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string"
            },
            "code": {
              "type": "string"
            },
            "$type": {
              "type": "string",
              "const": "Todo"
            }
          },
          "required": [
            "$type",
            "kind",
            "code"
          ]
        }
      ]
    },
    "DefineValue": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "string"
            },
            "$type": {
              "type": "string",
              "const": "StringLiteral"
            }
          },
          "required": [
            "$type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "$type": {
              "type": "string",
              "const": "IntegerLiteral"
            }
          },
          "required": [
            "$type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "boolean"
            },
            "$type": {
              "type": "string",
              "const": "BooleanLiteral"
            }
          },
          "required": [
            "$type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "c_type": {
              "$ref": "#/$defs/TypedIntegerLiteralCType"
            },
            "value": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "$type": {
              "type": "string",
              "const": "TypedIntegerLiteral"
            }
          },
          "required": [
            "$type",
            "c_type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "string"
            },
            "$type": {
              "type": "string",
              "const": "Symbol"
            }
          },
          "required": [
            "$type",
            "value"
          ]
        }
      ]
    },
    "TypedIntegerLiteralCType": {
      "type": "string",
      "pattern": "^int$"
    },
    "TypedefPrimitiveCType": {
      "type": "string",
      "pattern": "^(int|double)$"
    },
    "FunctionParameter": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/FunctionParameterType"
        },
        "comment": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "type"
      ]
    },
    "FunctionParameterType": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "pointee": {
              "$ref": "#/$defs/FunctionParameterType"
            },
            "$type": {
              "type": "string",
              "const": "Ptr"
            }
          },
          "required": [
            "$type",
            "pointee"
          ]
        },
        {
          "type": "object",
          "properties": {
            "pointee": {
              "$ref": "#/$defs/FunctionParameterType"
            },
            "$type": {
              "type": "string",
              "const": "ConstPtr"
            }
          },
          "required": [
            "$type",
            "pointee"
          ]
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "$ref": "#/$defs/TypeSimpleCName"
            },
            "$type": {
              "type": "string",
              "const": "SimpleC"
            }
          },
          "required": [
            "$type",
            "name"
          ]
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "$ref": "#/$defs/TypeSimpleNonCName"
            },
            "$type": {
              "type": "string",
              "const": "SimpleNonC"
            }
          },
          "required": [
            "$type",
            "name"
          ]
        }
      ]
    },
    "TypeSimpleCName": {
      "type": "string",
      "pattern": "^(void|bool|char|int|float|double|size_t|unsigned (char|short|int))$"
    },
    "TypeSimpleNonCName": {
      "type": "string",
      "pattern": "^Ofx[A-Z][a-zA-Z]*$"
    },
    "TypedefFunctionReturnType": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "$type": {
              "type": "string",
              "const": "OfxStatus"
            }
          },
          "required": [
            "$type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "$type": {
              "type": "string",
              "const": "Void"
            }
          },
          "required": [
            "$type"
          ]
        }
      ]
    },
    "TypedefStructField": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "comment_above": {
              "type": [
                "string",
                "null"
              ]
            },
            "item": {
              "$ref": "#/$defs/TypedefStructFieldItem"
            },
            "$type": {
              "type": "string",
              "const": "Item"
            }
          },
          "required": [
            "$type",
            "item"
          ]
        },
        {
          "type": "object",
          "properties": {
            "comment": {
              "type": "string"
            },
            "$type": {
              "type": "string",
              "const": "StandaloneComment"
            }
          },
          "required": [
            "$type",
            "comment"
          ]
        }
      ]
    },
    "TypedefStructFieldItem": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/TypedefStructFieldType"
        }
      },
      "required": [
        "name",
        "type"
      ]
    },
    "TypedefStructFieldType": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "$type": {
              "type": "string",
              "const": "ConstUnsignedCharPtr"
            }
          },
          "required": [
            "$type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "$type": {
              "type": "string",
              "const": "ConstCharPtr"
            }
          },
          "required": [
            "$type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "$type": {
              "type": "string",
              "const": "OfxPluginEntryPointPtr"
            }
          },
          "required": [
            "$type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "$ref": "#/$defs/TypeSimpleCName"
            },
            "$type": {
              "type": "string",
              "const": "SimpleC"
            }
          },
          "required": [
            "$type",
            "name"
          ]
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "$ref": "#/$defs/TypeSimpleNonCName"
            },
            "$type": {
              "type": "string",
              "const": "SimpleNonC"
            }
          },
          "required": [
            "$type",
            "name"
          ]
        },
        {
          "type": "object",
          "properties": {
            "parameters": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/FunctionParameter"
              }
            },
            "is_variadic": {
              "type": "boolean"
            },
            "return_type": {
              "$ref": "#/$defs/TypedefStructFieldTypeFunctionPointerReturnType"
            },
            "$type": {
              "type": "string",
              "const": "FunctionPointer"
            }
          },
          "required": [
            "$type",
            "parameters",
            "is_variadic",
            "return_type"
          ]
        }
      ]
    },
    "TypedefStructFieldTypeFunctionPointerReturnType": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "$type": {
              "type": "string",
              "const": "ConstVoidPtr"
            }
          },
          "required": [
            "$type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "$type": {
              "type": "string",
              "const": "OfxStatus"
            }
          },
          "required": [
            "$type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "$ref": "#/$defs/TypeSimpleCName"
            },
            "$type": {
              "type": "string",
              "const": "SimpleC"
            }
          },
          "required": [
            "$type",
            "name"
          ]
        }
      ]
    },
    "TypedefEnumVariant": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "c_value_expr": {
          "anyOf": [
            {
              "$ref": "#/$defs/TypedefEnumCValueExpr"
            },
            {
              "type": "null"
            }
          ]
        },
        "comment": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name"
      ]
    },
    "TypedefEnumCValueExpr": {
      "type": "string",
      "pattern": "^(0x[0-9a-fA-F]+|\\(\\s*[_a-zA-Z][_a-zA-Z0-9]*\\s*\\|\\s*[_a-zA-Z][_a-zA-Z0-9]*\\s*\\))$"
    }
  }
}