{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bindings",
  "type": "object",
  "properties": {
    "copyright_comments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "used_types": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string"
        }
      }
    },
    "used_consts": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string"
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RootItemWithCommentAbove"
      }
    }
  },
  "required": [
    "items"
  ],
  "$defs": {
    "RootItemWithCommentAbove": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "comment_above": {
              "type": [
                "string",
                "null"
              ]
            },
            "item": {
              "$ref": "#/$defs/RootItem"
            },
            "$type": {
              "type": "string",
              "const": "Item"
            }
          },
          "required": [
            "$type",
            "item"
          ]
        },
        {
          "type": "object",
          "properties": {
            "comment": {
              "type": "string"
            },
            "$type": {
              "type": "string",
              "const": "StandaloneComment"
            }
          },
          "required": [
            "$type",
            "comment"
          ]
        }
      ]
    },
    "RootItem": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/DefineValue"
            },
            "comment": {
              "type": [
                "string",
                "null"
              ]
            },
            "$type": {
              "type": "string",
              "const": "Define"
            }
          },
          "required": [
            "$type",
            "name",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "c_type": {
              "$ref": "#/$defs/CPrimitiveType"
            },
            "$type": {
              "type": "string",
              "const": "TypedefPrimitive"
            }
          },
          "required": [
            "$type",
            "name",
            "c_type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "pointee_struct_name": {
              "type": "string"
            },
            "$type": {
              "type": "string",
              "const": "TypedefOpaquePointer"
            }
          },
          "required": [
            "$type",
            "name",
            "pointee_struct_name"
          ]
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "parameters": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/FunctionParameter"
              }
            },
            "is_variadic": {
              "type": "boolean"
            },
            "return_type": {
              "$ref": "#/$defs/TypeStraightforward"
            },
            "$type": {
              "type": "string",
              "const": "TypedefFunction"
            }
          },
          "required": [
            "$type",
            "name",
            "return_type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "fields": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/TypedefStructField"
              }
            },
            "$type": {
              "type": "string",
              "const": "TypedefStruct"
            }
          },
          "required": [
            "$type",
            "name"
          ]
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "variants": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/TypedefEnumVariant"
              }
            },
            "$type": {
              "type": "string",
              "const": "TypedefEnum"
            }
          },
          "required": [
            "$type",
            "name"
          ]
        }
      ]
    },
    "DefineValue": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "string"
            },
            "$type": {
              "type": "string",
              "const": "StringLiteral"
            }
          },
          "required": [
            "$type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "$type": {
              "type": "string",
              "const": "IntegerLiteral"
            }
          },
          "required": [
            "$type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "boolean"
            },
            "$type": {
              "type": "string",
              "const": "BooleanLiteral"
            }
          },
          "required": [
            "$type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "c_type": {
              "$ref": "#/$defs/TypedIntegerLiteralCType"
            },
            "value": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "$type": {
              "type": "string",
              "const": "TypedIntegerLiteral"
            }
          },
          "required": [
            "$type",
            "c_type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "string"
            },
            "$type": {
              "type": "string",
              "const": "Identifier"
            }
          },
          "required": [
            "$type",
            "value"
          ]
        }
      ]
    },
    "TypedIntegerLiteralCType": {
      "type": "string",
      "pattern": "^int$"
    },
    "CPrimitiveType": {
      "type": "string",
      "pattern": "^(void|bool|char|int|float|double|size_t|unsigned (char|short|int))$"
    },
    "FunctionParameter": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/TypeStraightforward"
        },
        "comment": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "type"
      ]
    },
    "TypeStraightforward": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "pointee": {
              "$ref": "#/$defs/TypeStraightforward"
            },
            "$type": {
              "type": "string",
              "const": "Ptr"
            }
          },
          "required": [
            "$type",
            "pointee"
          ]
        },
        {
          "type": "object",
          "properties": {
            "pointee": {
              "$ref": "#/$defs/TypeStraightforward"
            },
            "$type": {
              "type": "string",
              "const": "ConstPtr"
            }
          },
          "required": [
            "$type",
            "pointee"
          ]
        },
        {
          "type": "object",
          "properties": {
            "is": {
              "$ref": "#/$defs/CPrimitiveType"
            },
            "$type": {
              "type": "string",
              "const": "CPrimitive"
            }
          },
          "required": [
            "$type",
            "is"
          ]
        },
        {
          "type": "object",
          "properties": {
            "is": {
              "$ref": "#/$defs/TypeIdentifier"
            },
            "$type": {
              "type": "string",
              "const": "TypeIdentifier"
            }
          },
          "required": [
            "$type",
            "is"
          ]
        }
      ]
    },
    "TypeIdentifier": {
      "type": "string",
      "pattern": "^Ofx[A-Z][_a-zA-Z\\d]*$"
    },
    "TypedefStructField": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "comment_above": {
              "type": [
                "string",
                "null"
              ]
            },
            "item": {
              "$ref": "#/$defs/TypedefStructFieldItem"
            },
            "$type": {
              "type": "string",
              "const": "Item"
            }
          },
          "required": [
            "$type",
            "item"
          ]
        },
        {
          "type": "object",
          "properties": {
            "comment": {
              "type": "string"
            },
            "$type": {
              "type": "string",
              "const": "StandaloneComment"
            }
          },
          "required": [
            "$type",
            "comment"
          ]
        }
      ]
    },
    "TypedefStructFieldItem": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/TypedefStructFieldType"
        }
      },
      "required": [
        "name",
        "type"
      ]
    },
    "TypedefStructFieldType": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "$ref": "#/$defs/TypeStraightforward"
            },
            "$type": {
              "type": "string",
              "const": "Straightforward"
            }
          },
          "required": [
            "$type",
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "parameters": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/FunctionParameter"
              }
            },
            "is_variadic": {
              "type": "boolean"
            },
            "return_type": {
              "$ref": "#/$defs/TypeStraightforward"
            },
            "$type": {
              "type": "string",
              "const": "FunctionPointer"
            }
          },
          "required": [
            "$type",
            "return_type"
          ]
        }
      ]
    },
    "TypedefEnumVariant": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "c_value_expr": {
          "anyOf": [
            {
              "$ref": "#/$defs/TypedefEnumCValueExpr"
            },
            {
              "type": "null"
            }
          ]
        },
        "comment": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name"
      ]
    },
    "TypedefEnumCValueExpr": {
      "type": "string",
      "pattern": "^(0x[\\da-fA-F]+|\\(\\s*[_a-zA-Z][_a-zA-Z\\d]*\\s*\\|\\s*[_a-zA-Z][_a-zA-Z\\d]*\\s*\\))$"
    }
  }
}