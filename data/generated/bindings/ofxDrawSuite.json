            "name": "kOfxStandardColourOverlayActive"
          },
          {
            "name": "kOfxStandardColourOverlaySelected"
          },
          {
            "name": "kOfxStandardColourOverlayDeselected"
          },
          {
            "name": "kOfxStandardColourOverlayMarqueeFG"
          },
          {
            "name": "kOfxStandardColourOverlayMarqueeBG"
          },
          {
            "name": "kOfxStandardColourOverlayText"
          }
        ]
      }
    },
    {
      "$type": "Item",
      "comment_above": "@brief Defines valid values for OfxDrawSuiteV1::setLineStipple",
      "item": {
        "$type": "TypedefEnum",
        "name": "OfxDrawLineStipplePattern",
        "variants": [
          {
            "name": "kOfxDrawLineStipplePatternSolid"
          },
          {
            "name": "kOfxDrawLineStipplePatternDot"
          },
          {
