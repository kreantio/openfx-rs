  "items": [
    {
      "$type": "StandaloneComment",
      "comment": "@file ofxDrawSuite.h\nAPI for host- and GPU API-independent drawing.\n@version Added in OpenFX 1.5"
    },
    {
      "$type": "Item",
      "comment_above": "@brief the string that names the DrawSuite, passed to OfxHost::fetchSuite",
      "item": {
        "$type": "Define",
        "name": "kOfxDrawSuite",
        "value": {
          "$type": "StringLiteral",
          "value": "OfxDrawSuite"
        }
      }
    },
    {
      "$type": "Item",
      "comment_above": "@brief Blind declaration of an OFX drawing context",
      "item": {
        "$type": "TypedefOpaquePointer",
        "name": "OfxDrawContextHandle",
        "pointee_struct_name": "OfxDrawContext"
      }
    },
    {
      "$type": "Item",
      "comment_above": "@brief The Draw Context handle\n \n @propdef\n type: pointer\n dimension: 1",
      "item": {
        "$type": "Define",
        "name": "kOfxInteractPropDrawContext",
        "value": {
          "$type": "StringLiteral",
          "value": "OfxInteractPropDrawContext"
        }
      }
    },
    {
      "$type": "Item",
      "comment_above": "@brief Defines valid values for OfxDrawSuiteV1::getColour",
      "item": {
        "$type": "TypedefEnum",
        "name": "OfxStandardColour",
        "variants": [
          {
            "name": "kOfxStandardColourOverlayBackground"
          },
