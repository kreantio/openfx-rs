{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Author: OpenCode 2 / DeepSeek V4.1 Flash (OpenCode Go, Default)",
  "type": "object",
  "required": ["copyright_comments", "items"],
  "additionalProperties": false,
  "properties": {
    "copyright_comments": { "type": "array", "items": { "type": "string" } },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/RootItemWithCommentAbove" }
    }
  },
  "$defs": {
    "RootItemWithCommentAbove": {
      "oneOf": [
        {
          "type": "object",
          "required": ["$type", "item"],
          "additionalProperties": false,
          "properties": {
            "$type": { "const": "Item" },
            "comment_above": { "type": "string" },
            "item": { "$ref": "#/$defs/RootItem" }
          }
        },
        {
          "type": "object",
          "required": ["$type", "comment"],
          "additionalProperties": false,
          "properties": {
            "$type": { "const": "StandaloneComment" },
            "comment": { "type": "string" }
          }
        }
      ]
    },
    "RootItem": {
      "oneOf": [
        {
          "type": "object",
          "required": ["$type", "name", "value"],
          "additionalProperties": false,
          "properties": {
            "$type": { "const": "Define" },
            "name": { "type": "string" },
            "value": { "$ref": "#/$defs/DefineValue" },
            "comment": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["$type", "code"],
          "additionalProperties": false,
          "properties": {
            "$type": { "const": "Todo" },
            "code": { "type": "string" }
          }
        }
      ]
    },
    "DefineValue": {
      "oneOf": [
        {
          "type": "object",
          "required": ["$type", "value"],
          "additionalProperties": false,
          "properties": {
            "$type": { "const": "StringLiteral" },
            "value": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["$type", "value"],
          "additionalProperties": false,
          "properties": {
            "$type": { "const": "IntegerLiteral" },
            "value": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
          }
        },
        {
          "type": "object",
          "required": ["$type", "value"],
          "additionalProperties": false,
          "properties": {
            "$type": { "const": "BooleanLiteral" },
            "value": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "required": ["$type", "ty", "value"],
          "additionalProperties": false,
          "properties": {
            "$type": { "const": "TypedIntegerLiteral" },
            "ty": { "$ref": "#/$defs/TypedIntegerLiteralType" },
            "value": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
          }
        },
        {
          "type": "object",
          "required": ["$type", "value"],
          "additionalProperties": false,
          "properties": {
            "$type": { "const": "Symbol" },
            "value": { "type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$" }
          }
        }
      ]
    },
    "TypedIntegerLiteralType": { "type": "string", "enum": ["Int"] }
  }
}
